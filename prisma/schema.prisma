generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Usuários do sistema (login) — a autenticação vem na Fase 2,
// mas o modelo já entra aqui para validar a conexão com o banco.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String // hash bcrypt, nunca a senha em texto puro
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  AGENT
}
