generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Usuários do sistema (login) — a autenticação vem na Fase 2,
// mas o modelo já entra aqui para validar a conexão com o banco.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String // hash bcrypt, nunca a senha em texto puro
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  AGENT
}

// Unidade do organograma (setor/órgão), em árvore via auto-relação
model OrgUnit {
  id          Int       @id @default(autoincrement())
  nome        String
  sigla       String?
  gestor      String?
  foto        String?   @db.Text // URL ou data-URI da foto do gestor
  fotoVisivel Boolean   @default(true)
  ordem       Int       @default(0)
  parentId    Int?
  parent      OrgUnit?  @relation("Hierarquia", fields: [parentId], references: [id], onDelete: Cascade)
  children    OrgUnit[] @relation("Hierarquia")
  gestores    GestorHistory[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("org_units")
}

// Histórico de gestores de cada unidade do organograma.
// Os documentos (URL, C.I/Ofício) ficam SOMENTE no banco — nunca no git.
model GestorHistory {
  id        Int      @id @default(autoincrement())
  orgUnitId Int
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  nome      String
  inicio    DateTime @default(now()) // data em que foi adicionado como gestor
  atual     Boolean  @default(false)
  docTipo      String?  // 'CI', 'OFICIO' ou 'OUTROS'
  docNumero    String?
  docUrl       String?  @db.Text
  docDescricao String?  @db.Text // usado quando docTipo = 'OUTROS': como a troca foi solicitada

  @@map("gestor_history")
}

// Telefone de contato mantido SOMENTE no ConectaOrg, complementando o
// cadastro de RH (externo, somente leitura, nunca escrito por aqui).
// "matricula" liga esse registro à pessoa na tabela externa (matricula_contrato).
// Cada novo número marca o anterior como não-atual, preservando histórico.
model ContatoTelefone {
  id        Int      @id @default(autoincrement())
  matricula String
  telefone  String
  atual     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  @@index([matricula])
  @@map("contato_telefones")
}

// Responsável (pessoa) vinculado a uma conta de webmail setorial — mantido
// SOMENTE no ConectaOrg. "username" liga à conta no banco de e-mails
// (externo, somente leitura); "matricula" liga à pessoa no banco de RH
// (externo, somente leitura). Os demais campos são um retrato da pessoa
// no momento do vínculo, preservado mesmo que o cadastro de origem mude
// depois — o histórico continua fazendo sentido.
model WebmailResponsavel {
  id             Int      @id @default(autoincrement())
  username       String
  matricula      String
  nome           String
  cpf            String?
  divisaoNome    String?
  subdivisaoNome String?
  unidadeNome    String?
  atual          Boolean  @default(true)
  vinculadoEm    DateTime @default(now())

  @@index([username])
  @@map("webmail_responsaveis")
}
