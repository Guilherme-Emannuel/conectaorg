generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Usuários do sistema (login) — a autenticação vem na Fase 2,
// mas o modelo já entra aqui para validar a conexão com o banco.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String // hash bcrypt, nunca a senha em texto puro
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  AGENT
}

// Unidade do organograma (setor/órgão), em árvore via auto-relação
model OrgUnit {
  id          Int       @id @default(autoincrement())
  nome        String
  sigla       String?
  gestor      String?
  foto        String?   @db.Text // URL ou data-URI da foto do gestor
  fotoVisivel Boolean   @default(true)
  ordem       Int       @default(0)
  parentId    Int?
  parent      OrgUnit?  @relation("Hierarquia", fields: [parentId], references: [id], onDelete: Cascade)
  children    OrgUnit[] @relation("Hierarquia")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("org_units")
}
