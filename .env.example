# ============================================
# EXEMPLO de configuração — valores HIPOTÉTICOS
# Copie este arquivo para .env e preencha com
# os valores reais. O .env NUNCA vai pro git.
# ============================================

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (MySQL/MariaDB)
# formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://usuario_exemplo:senha_exemplo@localhost:3306/conectaorg"

# Autenticação
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"
JWT_EXPIRES_IN="1d"

# EvolutionAPI (WhatsApp) — será usado nas fases futuras
EVOLUTION_API_URL="https://evolution.exemplo.com"
EVOLUTION_API_KEY="chave-api-hipotetica-123"

# n8n — será usado nas fases futuras
N8N_WEBHOOK_URL="https://n8n.exemplo.com/webhook/exemplo"
