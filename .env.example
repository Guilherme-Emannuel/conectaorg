# ============================================
# EXEMPLO de configuração — valores HIPOTÉTICOS
# Copie este arquivo para .env e preencha com
# os valores reais. O .env NUNCA vai pro git.
# ============================================

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (MySQL/MariaDB)
# formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://usuario_exemplo:senha_exemplo@localhost:3306/conectaorg"

# Autenticação
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"
JWT_EXPIRES_IN="1d"

# Admin inicial (criado pelo "npm run seed") — valores HIPOTÉTICOS
ADMIN_NAME="Administrador Exemplo"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="senha-forte-exemplo"

# Banco de dados EXTERNO (menu Usuários) — SOMENTE LEITURA
# Valores HIPOTÉTICOS; use um usuário de banco com privilégio apenas de SELECT
EXT_DB_HOST="db.exemplo.com"
EXT_DB_PORT="3306"
EXT_DB_NAME="banco_exemplo"
EXT_DB_USER="usuario_somente_leitura"
EXT_DB_PASSWORD="senha_exemplo"
EXT_DB_TABLE="tabela_exemplo"
EXT_DB_COLUMNS="nome,email,cargo"
# Rótulos dos cabeçalhos na tela, na mesma ordem das colunas (opcional)
EXT_DB_LABELS="NOME,E-MAIL,CARGO"

# API de Webmail (coluna "Webmail" na tela de Usuários) — será usada nas fases futuras
WEBMAIL_API_URL="https://webmail.exemplo.com/api"
WEBMAIL_API_KEY="chave-api-hipotetica-456"
WEBMAIL_API_LOOKUP_FIELD="matricula_contrato"

# EvolutionAPI (WhatsApp) — será usado nas fases futuras
EVOLUTION_API_URL="https://evolution.exemplo.com"
EVOLUTION_API_KEY="chave-api-hipotetica-123"

# n8n — será usado nas fases futuras
N8N_WEBHOOK_URL="https://n8n.exemplo.com/webhook/exemplo"
